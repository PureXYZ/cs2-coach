# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Your server's ID (right-click server icon → Copy Server ID, with developer mode on).
# Optional, but commands register instantly with it; global registration can take ~1h.
DISCORD_GUILD_ID=

# ── Game State Integration ───────────────────────────────────────────────────
# Port this app listens on for CS2's HTTP POSTs.
GSI_PORT=3000
# Shared secret — must match the token inside gamestate_integration_coach.cfg.
# Any random string works; `npm run cfg` writes it into the cfg for you.
GSI_TOKEN=change-me-to-something-random
# Record every raw GSI payload (+ the events derived from it) to logs/gsi-*.ndjson
# for offline analysis/debugging (roughly 1-5 MB per match). Set false to disable.
GSI_LOG_PAYLOADS=true

# ── Text-to-speech ───────────────────────────────────────────────────────────
# Comma-separated fallback chain. Options: deepgram, elevenlabs, edge.
# deepgram = recommended primary (fast, 48kHz Opus, $200 free signup credit ≈ 2+ years free)
# edge     = free, no key needed, slightly less reliable (undocumented Microsoft endpoint)
TTS_PROVIDER=deepgram,edge

# Deepgram: https://console.deepgram.com → API key (new accounts get $200 credit)
DEEPGRAM_API_KEY=
# Energetic coach voices: aura-2-apollo-en (male), aura-2-electra-en (female)
DEEPGRAM_TTS_MODEL=aura-2-apollo-en
# Opus bitrate in bps (Deepgram default is a muffled 12000; 64000 matches Discord voice)
DEEPGRAM_TTS_BITRATE=64000

# ElevenLabs (optional upgrade, needs ~$22/mo Creator plan at typical usage)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Voice settings on a 0-1 scale (the web dashboard shows them as percentages)
ELEVENLABS_STABILITY=0.3
ELEVENLABS_SIMILARITY=1.0
ELEVENLABS_STYLE=0.5
# Speech rate multiplier, 0.7-1.2 (1.0 = normal)
ELEVENLABS_SPEED=1.0

# Free Microsoft Edge voice used by the "edge" provider
EDGE_TTS_VOICE=en-US-GuyNeural

# ── Claude (tactical coaching brain) ─────────────────────────────────────────
# From https://platform.claude.com → API keys. Leave empty to run rule-based lines only.
ANTHROPIC_API_KEY=
# Smart tier (freezetime buy calls, halftime talks, match wrap-ups).
# claude-opus-4-8 = smartest coaching. With the default Haiku fast tier expect
# roughly $4-10/month at 20 matches; all-Haiku (both tiers) is ~$1/month.
COACH_LLM_MODEL=claude-opus-4-8
# Fast tier (mid-round retake/save calls, round-end reactions, teamkill roasts) —
# latency matters more than brilliance there. Set equal to COACH_LLM_MODEL for Opus everywhere.
COACH_LLM_FAST_MODEL=claude-haiku-4-5
# Reasoning effort for the smart tier: low | medium | high | max. Opus defaults to
# "high"; "low" is ~20% faster with no visible quality drop on one-line replies.
# Leave empty to omit (required if COACH_LLM_MODEL is a Haiku model, which rejects it).
COACH_LLM_EFFORT=low
LLM_ENABLED=true

# ── Coach personality ────────────────────────────────────────────────────────
# Spoken name for the player (defaults to the Steam name, which TTS may mangle).
PLAYER_NICKNAME=

# ── Post-match debrief ───────────────────────────────────────────────────────
# After each match: a scorecard embed + a short written coach's-notes paragraph
# posted to Discord (the bot needs Send Messages + Embed Links there, plus
# Read Message History for the Leetify reply).
COACH_DEBRIEF=true
# Channel ID to post it in. Empty = the chat of the coach's voice channel.
COACH_DEBRIEF_CHANNEL_ID=

# Once Leetify finishes parsing the match demo (typically 5-15 min), the coach
# replies to the debrief with their numbers (K/D, ADR, rating). Requires the
# player to have a Leetify account. Works without a key; one from
# https://leetify.com/app/developer raises the rate limits.
LEETIFY_ENABLED=true
LEETIFY_API_KEY=

# ── Deployment ───────────────────────────────────────────────────────────────
# SSH target for `npm run deploy` (pulls GitHub main on the host, rebuilds the
# Docker image, restarts the container). E.g. root@203.0.113.7
DEPLOY_HOST=
