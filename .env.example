# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Your server's ID (right-click server icon → Copy Server ID, with developer mode on).
# Optional, but commands register instantly with it; global registration can take ~1h.
DISCORD_GUILD_ID=

# ── Owner-only admin surface (/coachadmin) ────────────────────────────────────
# A private control command only you can use: detailed status (with feed SteamID64s),
# viewing/fixing Steam↔Discord links, and changing settings on the fly. Set BOTH values
# to enable it; leave either empty and the command is never registered. It's registered
# ONLY to the private admin guild below, so it never appears in your public server
# (Discord has no native way to show a command to just one user), and every use is
# also hard-gated on COACH_OWNER_ID.
#   COACH_OWNER_ID       your Discord user ID (Copy User ID, developer mode on)
#   COACH_ADMIN_GUILD_ID a PRIVATE server with just you + this bot (Copy Server ID)
COACH_OWNER_ID=
COACH_ADMIN_GUILD_ID=

# ── Game State Integration ───────────────────────────────────────────────────
# Port this app listens on for CS2's HTTP POSTs.
GSI_PORT=3000
# Shared secret — must match the token inside gamestate_integration_coach.cfg.
# Any random string works; `npm run cfg` writes it into the cfg for you.
GSI_TOKEN=change-me-to-something-random
# Record every raw GSI payload (+ the events derived from it) to logs/gsi-*.ndjson
# for offline analysis/debugging (roughly 1-5 MB per match). Set false to disable.
GSI_LOG_PAYLOADS=true

# ── Public address (where CS2 sends game state) ──────────────────────────────
# The coach's own public URL — the single source of truth baked into the cfg by
# both `npm run cfg` and the `/coach setup` Discord command. Point it at a stable
# DOMAIN so a server IP change never breaks a friend's already-installed cfg.
#   https://coach.example.com       → used verbatim (HTTPS on 443, recommended)
#   http://coach.example.com:3000   → used verbatim (domain, no TLS)
#   203.0.113.7                     → becomes http://203.0.113.7:GSI_PORT
# Required for `/coach setup` (the bot can't self-detect its public address from
# inside a container). Leave empty for purely-local dev — `npm run cfg` then falls
# back to this machine's LAN IP.
COACH_PUBLIC_HOST=

# ── Text-to-speech ───────────────────────────────────────────────────────────
# Comma-separated fallback chain. Options: deepgram, elevenlabs, edge.
# deepgram = recommended primary (fast, 48kHz Opus, $200 free signup credit ≈ 2+ years free)
# edge     = free, no key needed, slightly less reliable (undocumented Microsoft endpoint)
TTS_PROVIDER=deepgram,edge

# Deepgram: https://console.deepgram.com → API key (new accounts get $200 credit)
DEEPGRAM_API_KEY=
# Energetic coach voices: aura-2-apollo-en (male), aura-2-electra-en (female)
DEEPGRAM_TTS_MODEL=aura-2-apollo-en
# Opus bitrate in bps (Deepgram default is a muffled 12000; 64000 matches Discord voice)
DEEPGRAM_TTS_BITRATE=64000

# ElevenLabs (optional upgrade, needs ~$22/mo Creator plan at typical usage)
ELEVENLABS_API_KEY=
# The voice the coach speaks with. Copy a voice's ID from your ElevenLabs
# dashboard (Voices → a voice → ID). Used when ELEVENLABS_VOICES below is empty.
ELEVENLABS_VOICE_ID=
# Optional: several SWITCHABLE voices, as a comma-separated list of "Label:voiceId"
# entries (the FIRST is the default). Switch live in Discord with /coach voice (the
# pick persists across restarts), or pick a one-off voice with /coach say. Use your
# own labels/IDs; leave empty to just use the single ELEVENLABS_VOICE_ID above.
#   ELEVENLABS_VOICES=Coach:voiceId1,Hype:voiceId2,Chill:voiceId3
# Each entry may also carry a PER-VOICE speech rate and playback volume:
#   "Label:voiceId:speed:volume"  (speed 0.7-1.2, volume 0.1-2)
# A per-voice value overrides the global ELEVENLABS_SPEED / COACH_VOLUME for that
# voice only; omit to inherit the globals. They're positional, so to set just the
# volume, give the speed too (e.g. ":1.0:0.9").
#   ELEVENLABS_VOICES=Kevin:voiceId1:0.9:0.9,Aleks:voiceId2:0.9:0.95,Andy:voiceId3:1.0:0.9,Young Kevin:voiceId4:0.95:0.75
ELEVENLABS_VOICES=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Voice settings on a 0-1 scale (the web dashboard shows them as percentages)
ELEVENLABS_STABILITY=0.3
ELEVENLABS_SIMILARITY=1.0
ELEVENLABS_STYLE=0.5
# Speech rate multiplier, 0.7-1.2 (1.0 = normal). Default for all voices; override
# per-voice with the optional speed field in ELEVENLABS_VOICES above.
ELEVENLABS_SPEED=1.0

# Free Microsoft Edge voice used by the "edge" provider
EDGE_TTS_VOICE=en-US-GuyNeural

# --- TTS line cache -----------------------------------------------------------
# Caches the synthesized audio of the static, latency-critical canned lines (the
# 10s bomb-timer, late-round, zeus, bomb plant/defuse/explode, match-point) so a
# repeat plays with ~0ms synth instead of a ~225-900ms provider round-trip. Only
# those fixed lines are ever cached — interpolated/LLM lines never are.
TTS_CACHE_ENABLED=true
# Cache directory. Default lives under the state volume so it survives restarts/deploys.
TTS_CACHE_DIR=state/tts-cache
# Pre-synthesize every cacheable line × configured voice in the BACKGROUND at startup
# (and via `npm run prewarm`) so even the FIRST occurrence of a line isn't delayed.
TTS_PREWARM=true
# Safety cap on stored entries (the cacheable set is small; this only reclaims old
# entries orphaned by settings/line edits). 0 = unbounded.
TTS_CACHE_MAX_ENTRIES=2000

# Coach playback volume. 1.0 = source level (default) and skips transcoding — the
# fast path. Any other value (here, or a per-voice volume in ELEVENLABS_VOICES)
# re-encodes the audio to apply the gain (ffmpeg decodes, opusscript re-encodes), so
# FFmpeg must be on PATH. It's bundled in the Docker image; for a local non-1.0 gain
# install it (`winget install Gyan.FFmpeg` or `apt install ffmpeg`). Adds a small
# per-line latency. Examples: 0.9 = 10% quieter, 1.2 = louder. Range 0.1-2.
# Coach lines only, not playlist songs. Default for all voices; override per-voice in
# ELEVENLABS_VOICES above. Tip: Discord's right-click → User Volume on the bot adjusts
# loudness for just you, no restart.
COACH_VOLUME=1.0

# ── Claude (tactical coaching brain) ─────────────────────────────────────────
# From https://platform.claude.com → API keys. Leave empty to run rule-based lines only.
ANTHROPIC_API_KEY=
# Smart tier (freezetime buy calls, halftime talks, match wrap-ups).
# claude-opus-4-8 = smartest coaching. With the default Haiku fast tier expect
# roughly $4-10/month at 20 matches; all-Haiku (both tiers) is ~$1/month.
COACH_LLM_MODEL=claude-opus-4-8
# Fast tier (mid-round retake/save calls, round-end reactions, teamkill roasts) —
# latency matters more than brilliance there. Set equal to COACH_LLM_MODEL for Opus everywhere.
COACH_LLM_FAST_MODEL=claude-haiku-4-5
# Reasoning effort for the smart tier: low | medium | high | max. Opus defaults to
# "high"; "low" is ~20% faster with no visible quality drop on one-line replies.
# The dead-air moments (match wrap-up, timeout speech, Leetify recap) override
# this with "high" automatically — latency is free there.
# Leave empty to omit (required if COACH_LLM_MODEL is a Haiku model, which rejects it).
COACH_LLM_EFFORT=low
LLM_ENABLED=true

# ── Coach personality ────────────────────────────────────────────────────────
# Spoken name for the player (defaults to the Steam name, which TTS may mangle).
PLAYER_NICKNAME=

# ── Multi-player team coaching ───────────────────────────────────────────────
# Your friends can run the SAME generated cfg (same host, same GSI_TOKEN) and the
# coach will read everyone's game state at once — naming teammates, syncing buys,
# and calling drops. Each CS2 client self-identifies by its Steam ID, so there's
# nothing per-friend to configure; they just drop the cfg in their csgo\cfg\ folder.
#
# YOUR SteamID64 — the "primary" feed that owns cross-session memory and the
# Leetify recap. Set it so those bind to your account even if a friend's CS2
# connects first. Find yours at steamid.io or steamdb.info/calculator. Unset =
# the coach adopts the first feed it sees and pins it (fine when you play solo).
COACH_PRIMARY_STEAM64=
# How big a full stack is, so the coach can speak with whole-team certainty ("you're
# the last one alive", "everyone's broke") once that many confirmed teammate feeds are
# wired. A Premier team is 5. Unset = always hedge to "the players I can see", which can
# never produce a confident wrong call if someone forgets to launch. For a rotating crew
# (any 5 of a wider friend group), this alone is enough WHEN YOU'RE PLAYING — five
# confirmed same-side feeds is a full team, whoever the five are.
COACH_SQUAD_SIZE=
# OPTIONAL — your crew POOL: every friend's SteamID64 (including your own), comma-
# separated. Set this ONLY if you want the coach to also recognise and coach a full
# stack of your crew in games YOU'RE NOT PLAYING IN. It scopes "whose games to talk
# about" to your group and tells apart two of your friends' separate games from the
# round-win history. Needs COACH_PRIMARY_STEAM64 and COACH_SQUAD_SIZE set too. Note: in
# games you're not in, whole-team calls only start after ~4 rounds (before that there's
# no round history to tell two same-map games apart, so the coach safely hedges).
# Example: COACH_SQUAD=76561198000000001,76561198000000002,76561198000000003
COACH_SQUAD=
# Team-economy tactics: buy-sync + named drop calls at freezetime, last-man framing.
# On by default; set to false to keep the coach focused on you alone.
COACH_TEAM_TACTICS=true
# A longer pre-match scouting SPEECH during the warmup window (before round 1),
# where no buy call competes. Leans on your Leetify map/recent form when that's on
# (LEETIFY_MATCH_START). On by default; safe even if CS2 sends little warmup — the
# speech is just dropped the instant round 1 starts, never played over the pistol.
COACH_WARMUP_SPEECH=true
# Multi-feed liveness tuning (rarely need changing):
#   GSI_FEED_STALE_MS   a feed counts as connected/alive only within this window
#                       (default 15000; keep it above the 10s cfg heartbeat)
#   GSI_FEED_IDLE_MS    a feed silent this long is dropped from the roster (default 60000)
#   GSI_GLOBAL_SEAM_MS  collapse a duplicate round/bomb event when the event
#                       "authority" feed is re-elected (default 4000)
GSI_FEED_STALE_MS=15000
GSI_FEED_IDLE_MS=60000
GSI_GLOBAL_SEAM_MS=4000

# ── Leetify post-match stats ─────────────────────────────────────────────────
# Once Leetify finishes parsing the match demo (typically 5-15 min), the coach
# reads the headline numbers (K/D, ADR, rating) out in voice — only between
# games, never mid-match. Requires the player to have a Leetify account.
# Works without a key; one from https://leetify.com/app/developer raises the
# rate limits.
LEETIFY_ENABLED=true
LEETIFY_API_KEY=
# Use Leetify at MATCH START too: one keyless profile fetch (no demo-parse wait)
# lets the warmup speech / round-1 greeting note how you've been doing on this map,
# whether you just played it, and your recent form — spoken qualitatively (no raw
# numbers). On by default; gated by LEETIFY_ENABLED above.
LEETIFY_MATCH_START=true
# When friends are wired in (team tactics on), the recap can cover the whole crew
# from the per-match rows Leetify already returns. "full" (default) reads a short
# line for every wired friend so the coach can roast the whole board; "leaders"
# only names who topped each stat (gentler — won't air a friend's worst number);
# "off" keeps the recap to you alone.
LEETIFY_SQUAD_RECAP=full

# ── Deployment ───────────────────────────────────────────────────────────────
# SSH target for `npm run deploy` (pulls GitHub main on the host, rebuilds the
# Docker image, restarts the container). E.g. root@203.0.113.7
DEPLOY_HOST=

# ── Advanced tuning (sane defaults; uncomment only if you need them) ──────────
# Extra knobs read by src/config.ts but rarely changed:
#   GSI_LASTMAN_FRESH_MS=3000        how recent a death must be for a "last man" call
#   GSI_LOG_RETENTION_DAYS=14        auto-delete logs/ files older than this (0 = keep)
#   ROUND_SECONDS=115                round length for the locally derived clock
#   BOMB_SECONDS=40                  C4 timer for the locally derived clock
#   COACH_LLM_MAX_TOKENS=150         cap on a coach line's length
#   COACH_LLM_TIMEOUT_MS=9000        smart-tier give-up time (falls back to a rule line)
#   COACH_LLM_FAST_TIMEOUT_MS=6000   mid-round give-up time
#   COACH_DEBUG=false                verbose tracing of why a line did/didn't fire
#   COACH_LOG_DECISIONS=false        append every spoken/dropped decision to logs/decisions-*.ndjson
